    "/api/v1/jobs/schedule": {
      "post": {
        "tags": [
          "Job"
        ],
        "summary": "create a new job",
        "operationId": "schedule_job",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "a_blueprint_id",
                  "b_job_type",
                  "c_node0",
                  "c_node1",
                  "c_node2",
                  "input_party0",
                  "input_party1",
                  "input_party2"
                ],
                "properties": {
                  "a_blueprint_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "b_job_type": {
                    "$ref": "#/components/schemas/JobType"
                  },
                  "c_node0": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "c_node1": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "c_node2": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "d_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "input_party0": {
                    "type": "string",
                    "format": "binary"
                  },
                  "input_party1": {
                    "type": "string",
                    "format": "binary"
                  },
                  "input_party2": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Schedule a new job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleJobResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
